
from tkinter import *
from tkinter import messagebox
import mysql.connector as sql

a = Tk()
a.geometry("800x600")
a.config(bg="skyblue")

t1 = StringVar()
t2 = StringVar()
t3 = StringVar()
t4 = StringVar()


def add():
    try:
        con = sql.connect(
            host="localhost",
            user="root",
            password="",
            database="rajesh"
        )

        c = con.cursor()

        c.execute(
            "INSERT INTO bro (id, name, address, designation) VALUES (%s, %s, %s, %s)",
            (t1.get(), t2.get(), t3.get(), t4.get())
        )

        con.commit()

        messagebox.showinfo("Success", "Employee details added")

        con.close()

    except Exception as e:
        messagebox.showerror("Error", str(e))


