    def create_account(self,id,holder_name,type):
        if type=="saving":
            new_account=SavingAccount(id,holder_name)
        elif type=="current":
            new_account=CurrentAccount(id,holder_name)
        self._account[id]=new_account
        print("Account creat succesfull")
        return new_account
    def get_account(self,id):
        if id not in self._accounts:
            print("Account not found")
            return None
        else:
            account=self.accounts[id]
            print(f"\nID: {account.id}\nHolder name : {account.holder_name}")
            return account

