class CurrentAccount(Account):  #polymorpsim
    def Withdraw (self,amount):
        OVERRED_LIMIT=1000 
        if self._balance + OVERRED_LIMIT >= amount:
            self._balance -= amount
            print(f"withdraw succefull.updated balance:{self._balance}")
        else:
            print("ask is over limit")

