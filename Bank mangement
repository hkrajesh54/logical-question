class Account:
    def __init__(self,id,holder_name):
        self.id=id
        self.holder_name=holder_name
        self._balance=0  #encapsulation

        
    def check_balance(self):
        print(f"Balance :{self._balance}")

    def Deposit(self,amount):
        self._balance += amount
        print(f"Deposit succefull.updated balance:{self._balance}")

    def Withdraw(self,amount):
        if self._balance >= amount:
            self._balance -= amount
            print(f"withdraw succefull.updated balance:{self._balance}")
        else:
            print("Balance is less than ask")
        
        
